<mxfile host="app.diagrams.net">
  <diagram id="auto-market-pipeline" name="Architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Auto Industry Market Data Pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#666666&quot;&gt;Automated ELT: Extract → Load raw → Transform in the warehouse&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="360" y="10" width="800" height="60" as="geometry" />
        </mxCell>

        <!-- GitHub Actions container (dashed) -->
        <mxCell id="gha" value="&lt;b&gt;GitHub Actions&lt;/b&gt;  ·  scheduled Mon–Fri 22:00 UTC  ·  run_pipeline.py" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;strokeWidth=2;strokeColor=#24292f;fillColor=#f6f8fa;verticalAlign=top;align=center;fontSize=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="95" width="1000" height="230" as="geometry" />
        </mxCell>

        <!-- 1. Source -->
        <mxCell id="src" value="&lt;b&gt;Yahoo Finance API&lt;/b&gt;&lt;br&gt;(yfinance)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Daily OHLCV for 9 auto companies&lt;br&gt;NSE · NYSE · Tokyo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="155" width="190" height="130" as="geometry" />
        </mxCell>

        <!-- 2. Extract -->
        <mxCell id="ext" value="&lt;b&gt;Python extract&lt;/b&gt;&lt;br&gt;extract_prices.py&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Backfill 2 yrs / incremental&lt;br&gt;7-day overlap · retries&lt;br&gt;Idempotent upsert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="270" y="155" width="210" height="130" as="geometry" />
        </mxCell>

        <!-- 3. Raw warehouse -->
        <mxCell id="raw" value="&lt;b&gt;DuckDB · raw&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;raw.prices&lt;br&gt;PK (ticker, date)&lt;br&gt;ingested_at&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="170" height="140" as="geometry" />
        </mxCell>

        <!-- 4. dbt -->
        <mxCell id="dbt" value="&lt;b&gt;dbt build&lt;/b&gt;&lt;br&gt;(dbt-duckdb)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;staging → marts&lt;br&gt;star schema&lt;br&gt;18 data quality tests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="730" y="155" width="190" height="130" as="geometry" />
        </mxCell>

        <!-- 5. Analytics warehouse -->
        <mxCell id="ana" value="&lt;b&gt;DuckDB · analytics&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;dim_company&lt;br&gt;fct_daily_prices&lt;br&gt;mart_monthly_performance&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="960" y="150" width="190" height="140" as="geometry" />
        </mxCell>

        <!-- 6. Dashboard -->
        <mxCell id="dash" value="&lt;b&gt;Streamlit dashboard&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Prices + 20-day MA&lt;br&gt;Monthly returns&lt;br&gt;2W vs 4W comparison&lt;br&gt;Streamlit Community Cloud&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1300" y="155" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- Seed feeding dbt -->
        <mxCell id="seed" value="&lt;b&gt;seeds/companies.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ticker list + company metadata&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="360" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="e1" value="API call" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src" target="ext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Load" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#f6f8fa;" edge="1" parent="1" source="ext" target="raw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Transform" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#f6f8fa;" edge="1" parent="1" source="raw" target="dbt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Build + test" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#f6f8fa;" edge="1" parent="1" source="dbt" target="ana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Read-only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ana" target="dash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="dbt seed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="seed" target="dbt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="ticker list" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#d6b656;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="seed" target="ext">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="375" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Footer -->
        <mxCell id="footer" value="&lt;font color=&quot;#555555&quot;&gt;Each weekday run commits the updated warehouse.duckdb back to GitHub → Streamlit redeploys with fresh data&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="960" y="445" width="540" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
